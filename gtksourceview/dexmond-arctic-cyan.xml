<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dexmond Arctic Cyan: GtkSourceView style scheme (GNOME Text Editor, gedit,
  Builder and other GtkSourceView editors). MIT licence, see LICENSE.
  The metadata block is read by GtkSourceView 5; install.sh removes it from
  the copies it puts in the GtkSourceView 3/4 and gedit folders.
-->
<style-scheme id="dexmond-arctic-cyan" name="Dexmond Arctic Cyan" version="1.0">
  <author>Dexmond Technologies</author>
  <description>Navy background, Arctic Cyan accents.</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <color name="void"      value="#05070d"/>
  <color name="navy"      value="#070912"/>
  <color name="line"      value="#0c1424"/>
  <color name="edge"      value="#16283c"/>
  <color name="fg"        value="#d0efff"/>
  <color name="dim"       value="#8fb0c6"/>
  <color name="comment"   value="#7f9db3"/>
  <color name="cyan"      value="#00f5ff"/>
  <color name="sky"       value="#5ce1ff"/>
  <color name="blue"      value="#7aa8ff"/>
  <color name="violet"    value="#c49bff"/>
  <color name="magenta"   value="#f07bf5"/>
  <color name="pink"      value="#ff5ca8"/>
  <color name="mint"      value="#3ef0a0"/>
  <color name="yellow"    value="#ffd24d"/>
  <color name="ink"       value="#03121a"/>

  <!-- Editor -->
  <style name="text"                    foreground="fg" background="void"/>
  <style name="selection"               foreground="#ffffff" background="#0b4a58"/>
  <style name="selection-unfocused"     foreground="fg" background="#0b3644"/>
  <style name="cursor"                  foreground="cyan"/>
  <style name="secondary-cursor"        foreground="sky"/>
  <style name="current-line"            background="line"/>
  <style name="line-numbers"            foreground="#5d7689" background="navy"/>
  <style name="current-line-number"     foreground="cyan" background="line" bold="true"/>
  <style name="right-margin"            foreground="#00f5ff" background="#070b14"/>
  <style name="draw-spaces"             foreground="#23415a"/>
  <style name="background-pattern"      background="#080c16"/>
  <style name="bracket-match"           foreground="ink" background="cyan" bold="true"/>
  <style name="bracket-mismatch"        foreground="#ffffff" background="#a8155f" underline="true"/>
  <style name="search-match"            foreground="ink" background="yellow"/>
  <style name="map-overlay"             background="#0c1424"/>
  <style name="snippet-focus"           background="#0b3644"/>

  <!-- Generic syntax -->
  <style name="def:comment"             foreground="comment" italic="true"/>
  <style name="def:shebang"             foreground="comment" bold="true"/>
  <style name="def:doc-comment-element" foreground="sky" italic="true"/>
  <style name="def:constant"            foreground="violet"/>
  <style name="def:character"           foreground="mint"/>
  <style name="def:string"              foreground="mint"/>
  <style name="def:special-char"        foreground="yellow"/>
  <style name="def:number"              foreground="magenta"/>
  <style name="def:floating-point"      foreground="magenta"/>
  <style name="def:decimal"             foreground="magenta"/>
  <style name="def:base-n-integer"      foreground="magenta"/>
  <style name="def:boolean"             foreground="violet" bold="true"/>
  <style name="def:identifier"          foreground="sky"/>
  <style name="def:function"            foreground="cyan"/>
  <style name="def:statement"           foreground="cyan" bold="true"/>
  <style name="def:keyword"             foreground="cyan" bold="true"/>
  <style name="def:type"                foreground="blue" bold="true"/>
  <style name="def:preprocessor"        foreground="violet"/>
  <style name="def:builtin"             foreground="blue"/>
  <style name="def:operator"            foreground="dim"/>
  <style name="def:special-constant"    foreground="violet"/>
  <style name="def:note"                foreground="ink" background="yellow" bold="true"/>
  <style name="def:warning"             foreground="yellow" bold="true"/>
  <style name="def:error"               foreground="pink" underline="error"/>
  <style name="def:net-address"         foreground="sky" underline="single"/>
  <style name="def:link-destination"    foreground="sky" underline="single"/>
  <style name="def:link-text"           foreground="cyan"/>
  <style name="def:underlined"          underline="single"/>
  <style name="def:emphasis"            italic="true"/>
  <style name="def:strong-emphasis"     bold="true"/>
  <style name="def:heading"             foreground="cyan" bold="true"/>
  <style name="def:inline-code"         foreground="mint"/>
  <style name="def:preformatted-section" foreground="mint"/>
  <style name="def:list-marker"         foreground="cyan" bold="true"/>
  <style name="def:insertion"           foreground="mint"/>
  <style name="def:deletion"            foreground="pink" strikethrough="true"/>

  <!-- Diff -->
  <style name="diff:added-line"         foreground="mint"/>
  <style name="diff:removed-line"       foreground="pink"/>
  <style name="diff:changed-line"       foreground="yellow"/>
  <style name="diff:diff-file"          foreground="cyan" bold="true"/>
  <style name="diff:location"           foreground="violet"/>
  <style name="diff:special-case"       foreground="dim"/>

  <!-- Markup -->
  <style name="xml:element-name"        foreground="cyan"/>
  <style name="xml:attribute-name"      foreground="sky"/>
  <style name="xml:attribute-value"     foreground="mint"/>
  <style name="xml:namespace"           foreground="violet"/>
  <style name="xml:processing-instruction" foreground="comment" bold="true"/>
  <style name="css:property-name"       foreground="sky"/>
  <style name="css:id-selector"         foreground="cyan"/>
  <style name="css:type-selector"       foreground="blue"/>
  <style name="css:pseudo-selector"     foreground="violet"/>
  <style name="css:vendor-specific"     foreground="comment"/>
  <style name="python:builtin-function" foreground="blue"/>
  <style name="python:class-name"       foreground="blue" bold="true"/>
  <style name="python:module-handler"   foreground="cyan" bold="true"/>
  <style name="rust:macro"              foreground="violet"/>
  <style name="rust:lifetime"           foreground="yellow"/>
  <style name="sh:variable"             foreground="sky"/>
</style-scheme>
